; Kopie als config/live.ini ausfüllen. Diese Datei wird nicht hochgeladen/eingecheckt.
; Live-Ziel: <remote-app-root>/shared/app.ini (außerhalb des Webroots).
APP_ENV = "production"
DB_DRIVER = "pgsql"
DB_HOST = "EINTRAGEN"
DB_PORT = "5432"
DB_NAME = "EINTRAGEN"
DB_USER = "EINTRAGEN"
DB_PASSWORD = "EINTRAGEN"
; Nach Hetzner-Verbindungsdaten einstellen. require verschlüsselt ohne Identitätsprüfung.
; Für verify-full zusätzlich den passenden CA-Pfad unter DB_SSLROOTCERT eintragen.
DB_SSLMODE = "require"
MENU_SEED = "speisekarte"
; Private Tageslogs neben public_html, Datum nach Europe/Berlin. Heute plus sechs Vortage.
; LOG_DIR = "/usr/home/ACCOUNT/SEC"
; LOG_LEVEL = "info"
